// SATU AI — Prisma schema
// PostgreSQL (Neon.tech / Supabase, free tier) dengan connection pooling.
//
// Migration:
//   npx prisma migrate dev --name init     (development, buat migrasi + apply)
//   npx prisma migrate deploy              (production / CI)
//   npm run db:seed                        (isi user awal + konfigurasi posko)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl dipakai prisma migrate (koneksi non-pooled). Opsional; jika tak diisi
  // Prisma akan memakai DATABASE_URL. Aman untuk Neon/Supabase.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  RELAWAN
  ADMIN
}

enum SumberInput {
  USER
  RELAWAN
  MANDIRI
}

enum Level {
  HIJAU
  KUNING
  MERAH
}

enum Instansi {
  DINAS_KESEHATAN
  DINAS_SOSIAL
  BPBD
}

model User {
  id           String             @id @default(cuid())
  username     String             @unique
  email        String?            @unique
  namaLengkap  String?
  noHp         String?
  passwordHash String
  role         Role               @default(USER)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt
  kasus        Kasus[]
  posko        Posko[]
  resetOtps    PasswordResetOtp[]
  donasi       TransaksiDonasi[]
  pendaftaranRelawan PendaftaranRelawan[]
}

model PasswordResetOtp {
  id             String   @id @default(cuid())
  email          String
  otpHash        String   // SHA-256 (otp + pepper)
  resetTokenHash String?  // SHA-256 (resetToken + pepper)
  attempts       Int      @default(0) // Max 5 percobaan salah sebelum terkunci
  expiresAt      DateTime
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model Kasus {
  id                    String      @id @default(cuid())
  kodeUnik              String      @unique // untuk QR mode mandiri
  sumberInput           SumberInput
  namaKK                String?
  usiaKK                Int?
  anggotaKeluarga       Json? // [{hubungan, usia, kondisiKhusus}]
  kondisiMedisKritis    Json? // string[]
  obatTersedia          Boolean?
  mobilitas             String?
  asalLokasi            String?
  agentThought          String? // hasil reasoning LLM, untuk audit
  provenance            Json?   // metadata PRANA (source, confidence per field)
  skorKerentanan        Int         @default(0) // dihitung rule engine, BUKAN LLM
  levelPrioritas        Level       @default(HIJAU)
  instansiRujukan       Instansi?
  statusVerifikasiMedis Boolean     @default(false) // wajib true untuk kasus MERAH final
  status                String      @default("pending") // pending | terverifikasi
  geoLat                Float?
  geoLng                Float?
  isSpam                Boolean     @default(false)
  fotoUrl               String?
  createdById           String?
  createdBy             User?       @relation(fields: [createdById], references: [id])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([levelPrioritas])
  @@index([status])
  @@index([isSpam])
  @@index([instansiRujukan])
  @@index([createdById])
}

model AuditLog {
  id        String   @id @default(cuid())
  aksi      String
  aktor     String
  kasusId   String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([kasusId])
  @@index([createdAt])
}

model PoskoConfig {
  id          String @id @default(cuid())
  kodePosko   String @unique // dipakai di URL /mandiri/[kodePosko]
  nama        String @default("Posko Pengungsian")
  lat         Float
  lng         Float
  radiusMeter Int    @default(2000) // validasi anti-spam mode mandiri
}

model LaporanHarian {
  id             String   @id @default(cuid())
  tanggal        DateTime @default(now())
  ringkasanAI    String // draft dari AI
  ringkasanFinal String? // setelah diedit admin
  dikirimOleh    String?
  terkirim       Boolean  @default(false)
}

// ── Fitur: Peta Kebutuhan Lintas-Posko ──────────────────────

enum KategoriKebutuhan {
  obat_demam_analgesik
  obat_kronis
  kebutuhan_bayi
  kebutuhan_ibu_hamil
  air_bersih
  makanan_pokok
  selimut_pakaian
  tenaga_medis
  lainnya
}

enum StatusKebutuhan {
  pending
  dikonfirmasi
}

model Posko {
  id              String            @id @default(cuid())
  namaPosko       String
  lat             Float
  lng             Float
  areaPublik      String // nama kecamatan/kabupaten (satu-satunya lokasi di layer publik)
  alamatText      String?
  adminId         String?
  admin           User?             @relation(fields: [adminId], references: [id])
  kebutuhanAgregat KebutuhanAgregat[]
  createdAt       DateTime          @default(now())

  @@index([areaPublik])
}

model KebutuhanAgregat {
  id                  String            @id @default(cuid())
  poskoId             String
  posko               Posko             @relation(fields: [poskoId], references: [id], onDelete: Cascade)
  kategori            KategoriKebutuhan
  ringkasanLaporan    String? // ringkasan apa adanya dari laporan relawan
  estimasiJumlah      Int? // nullable sampai dikonfirmasi
  urgensi             Level // HIJAU / KUNING / MERAH
  perluKonfirmasiMedis Boolean          @default(true) // SELALU true untuk output AI
  status              StatusKebutuhan  @default(pending)
  dikonfirmasiOleh    String?
  lastUpdated         DateTime         @updatedAt

  @@index([poskoId])
  @@index([status])
}

model GeocodeCache {
  id        String   @id @default(cuid())
  alamat    String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

// ── Modul Donasi Publik & Korban Bencana ───────────────────────

model DonasiKampanye {
  id                String            @id @default(cuid())
  slug              String            @unique
  judul             String
  deskripsi         String?
  targetDonasi      Int               // Target dana (Rupiah), e.g. 50000000
  terkumpul         Int               @default(0) // Dana terkumpul (Rupiah), e.g. 24500000
  jumlahDonatur     Int               @default(0) // Jumlah donatur terdaftar, e.g. 320
  kategoriTag       Json?             // string[] tags: ["Makanan", "Air & Kebutuhan dasar", "Medis"]
  alokasiDana       Json?             // string[] checklist alokasi dana
  penyelenggara     String            @default("Yayasan Bantu Sesama")
  penyelenggaraDesc String?           @default("Organisasi terverifikasi. Laporan penyaluran dana dipublikasikan secara transparan setiap tahap kegiatan")
  terverifikasi     Boolean           @default(true)
  aktif             Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  transaksi         TransaksiDonasi[]

  @@index([slug])
  @@index([aktif])
}

model TransaksiDonasi {
  id               String         @id @default(cuid())
  kodeDonasi       String         @unique // e.g. "#DONASI-49281"
  kampanyeId       String
  kampanye         DonasiKampanye @relation(fields: [kampanyeId], references: [id], onDelete: Cascade)
  nominal          Int            // Nominal dalam Rupiah, e.g. 100000
  metodePembayaran String         // "E_WALLET" | "VIRTUAL_ACCOUNT" | "BANK_TRANSFER"
  subMetode        String?        // "GOPAY" | "OVO" | "DANA" | "BCA_VA" | "MANDIRI_VA" | "BRI_VA" | "MANUAL"
  status           String         @default("MENUNGGU_PEMBAYARAN") // "MENUNGGU_PEMBAYARAN" | "BERHASIL" | "DIBATALKAN"
  nomorVa          String?
  qrPayload        String?
  namaDonatur      String?        @default("Hamba Allah")
  pesanDoa         String?
  anonim           Boolean        @default(true)
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([kampanyeId])
  @@index([status])
  @@index([userId])
}

// ── Modul Open Volunteer & Pendaftaran Relawan Lapangan ─────────

model KegiatanRelawan {
  id               String               @id @default(cuid())
  slug             String               @unique
  judul            String               // "Banjir Jakarta Timur"
  tanggalRentang   String               // "8-12 Oktober 2026"
  lokasi           String               // "Jakarta Timur"
  alamatSpesifik   String?              @default("Jl. Melati No.5, Jakarta Timur")
  kuotaTerisi      Int                  @default(0) // 24
  kuotaMaksimal    Int                  @default(50) // 50
  posisiDibutuhkan Json?                // ["Distribusi", "Logistik", "Dapur Umum"]
  deskripsi        String               // "Kegiatan relawan untuk membantu distribusi bantuan..."
  informasiTugas   String?              @default("Membantu distribusi paket bantuan kepada pengungsi di posko RW 05")
  waktuKegiatan    String?              @default("06.00 - 18.00 WIB")
  kontakKordinator String?              @default("08123425871667")
  aktif            Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  pendaftaran      PendaftaranRelawan[]

  @@index([slug])
  @@index([aktif])
}

model PendaftaranRelawan {
  id             String          @id @default(cuid())
  kegiatanId     String
  kegiatan       KegiatanRelawan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  namaLengkap    String
  email          String
  nomorTelepon   String
  kemampuan      String?
  pengalaman     String?
  posisi         String          // "Distribusi" | "Logistik" | "Dapur Umum"
  status         String          @default("TERDAFTAR") // "TERDAFTAR" | "DISETUJUI" | "SELESAI"
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([kegiatanId])
  @@index([userId])
  @@index([status])
}
